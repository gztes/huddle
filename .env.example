# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored — never commit it.

# Gemini API key. Get a free one from https://aistudio.google.com/apikey.
GEMINI_API_KEY=...

# ---------------------------------------------------------------- optional --

# Global hotkey that requests a suggestion. Format: Ctrl/Alt/Shift/Win + a key,
# joined with "+". Default shown below.
# HUDDLE_HOTKEY=Ctrl+Alt+H

# How many minutes of rolling transcript to send to Gemini when you hit the
# hotkey. Older lines fall off the front regardless of this — see
# HUDDLE_TRANSCRIPT_RETENTION_MINUTES below.
# HUDDLE_CONTEXT_WINDOW_MINUTES=5

# How long to keep transcript lines in memory at all before dropping them,
# even if you never hit the hotkey. Keeps a long call from growing unbounded.
# HUDDLE_TRANSCRIPT_RETENTION_MINUTES=30
